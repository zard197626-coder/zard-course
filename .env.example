# 复制为 .env 后按需修改；.env 不会被 Git 跟踪。
# SQLite 数据库路径。相对路径以项目根目录为基准。
DATABASE_PATH=backend/data/campus_market.db

# 可选：启动后端时自动创建管理员。密码留空则不自动创建。
# 也可以不配置，改用 `python -m backend.seed` 并在终端查看随机初始密码。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@campus.local

# 登录会话有效期（小时）
SESSION_TTL_HOURS=72

# 前端单独用静态服务器启动时需要的 CORS 来源，多个用英文逗号分隔。
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5500,http://localhost:5500
